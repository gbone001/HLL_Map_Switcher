# Multiple Servers Setup - Easy Format!

# Discord Settings
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_CHANNEL_ID=your_discord_channel_id

# Server 1
# CRCON HTTP API
SERVER1_CRCON_BASE_URL=https://your-crcon-host/api
SERVER1_CRCON_TOKEN=crcon-django-token

# Optional direct game-server RCON fallback
SERVER1_RCON_HOST=your-game-server-host
SERVER1_RCON_PORT=12345
SERVER1_RCON_PASSWORD=your_rcon_password

SERVER1_NAME=Frontline Server

# Server 2
# CRCON HTTP API
#SERVER2_CRCON_BASE_URL=https://your-crcon-host/api
#SERVER2_CRCON_TOKEN=crcon-django-token
#SERVER2_RCON_HOST=your-game-server-host
#SERVER2_RCON_PORT=12345
#SERVER2_RCON_PASSWORD=your_rcon_password

#SERVER2_NAME=Training Server

# Server 3
# CRCON HTTP API
#SERVER3_CRCON_BASE_URL=https://your-crcon-host/api
#SERVER3_CRCON_TOKEN=crcon-django-token
#SERVER3_RCON_HOST=your-game-server-host
#SERVER3_RCON_PORT=12345
#SERVER3_RCON_PASSWORD=your_rcon_password
#SERVER3_NAME=Event Server

# Add more servers as needed (SERVER4_CRCON_BASE_URL, SERVER4_NAME, etc.)

# Optional Settings
WARFARE_MATCH_TIMER_MINUTES=90
WARFARE_WARMUP_TIMER_MINUTES=3
# Optional per-server overrides:
# SERVER1_WARFARE_MATCH_TIMER_MINUTES=90
# SERVER1_WARFARE_WARMUP_TIMER_MINUTES=3
DEBUG=True

# Server booking (optional). Booking is disabled unless BOOKING_ROLE_ID and DISCORD_GUILD_ID are set;
# booking roles and admin rights only count inside DISCORD_GUILD_ID.
# Members with this role can /book a server; during their slot only they and booking admins
# (Discord Administrator permission or BOOKING_ADMIN_ROLE_ID) can change that server via the panel.
#BOOKING_ROLE_ID=123456789012345678
#BOOKING_ADMIN_ROLE_ID=123456789012345678
# IANA time zone that /book start times are entered in (default UTC).
#BOOKING_TIMEZONE=Australia/Sydney
# Defaults to data/bookings.db (/app/data/bookings.db in Docker, on the bind mount).
#BOOKING_DB_PATH=
# Sanity limits: longest single booking (hours) and how far ahead a booking may start (days).
#BOOKING_MAX_HOURS=24
#BOOKING_MAX_DAYS_AHEAD=90
# Panel lists bookings for today + the next 13 days, re-rendered daily at this time (BOOKING_TIMEZONE).
#BOOKING_PANEL_REFRESH_TIME=06:00
